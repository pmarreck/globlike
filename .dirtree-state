# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	INTENT.md = Shared pattern-library purpose and accepted language direction
	PCRE2-LICENSE.md = Required upstream PCRE2 license and notices
	PLAN.md = Remaining CLI consolidation and consumer integration work
	README.md = Pattern API, paired sigils, glob classes, migration guide, and build commands
	build = Optimized library build entry point
	build.zig = Zig module, static library, and complete test step
	build.zig.zon = Zig package identity and source manifest
	docs/PLAN_LOG.md = Archived implementation milestones and historical verification evidence
	docs/plan_context/consolidation.md = Current sigil contract, historical design decisions, and verification evidence
	flake.lock = Exact Nix dependency revisions
	flake.nix = Pinned Zig toolchain, ReleaseSafe tests, and ReleaseFast build
	src/lib.zig = Pattern API, paired sigil parser, PCRE2 DFA compilation and typed diagnostics
	src/syntax.zig = Paired sigil delimiters and linear-time glob class boundary index
	src/translate.zig = Glob and character class translation with source offsets and scoped regex excerpts
	test = Complete test suite entry point
	tests/unit/matching.zig = Set classifiers and structured PCRE2 diagnostic regressions
	tests/unit/parser.zig = Delimiter edge cases, allocation failures, nesting, and source preservation
	tests/unit/sigils.zig = Sigil and glob class classifiers, libc differential oracle, and Bash edge cases
]
